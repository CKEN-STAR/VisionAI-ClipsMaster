# VisionAI-ClipsMaster Environment Variables Configuration
# Copy this file to .env and modify values as needed

# ============================================
# Application Configuration
# ============================================
APP_NAME=VisionAI-ClipsMaster
APP_VERSION=1.0.1
APP_ENV=production
DEBUG=false
DEVELOPMENT=false

# ============================================
# Python Configuration
# ============================================
PYTHONPATH=/app
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================
# Display and GUI Configuration
# ============================================
DISPLAY=:99
QT_QPA_PLATFORM=offscreen
MPLBACKEND=Agg

# ============================================
# AI/ML Configuration
# ============================================
CUDA_VISIBLE_DEVICES=""
TORCH_HOME=/app/cache/torch
TRANSFORMERS_CACHE=/app/cache/transformers
HF_HOME=/app/cache/huggingface
HUGGINGFACE_HUB_CACHE=/app/cache/huggingface

# Model Configuration
DEFAULT_MODEL_LANGUAGE=zh
MODEL_DOWNLOAD_TIMEOUT=3600
MODEL_MAX_RETRIES=3

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://visionai:visionai123@postgres:5432/visionai
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visionai
DB_USER=visionai
DB_PASSWORD=visionai123
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_MAX_CONNECTIONS=10

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ============================================
# Web Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
WEB_PORT=8080
API_PORT=5000
WORKERS=1
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=300
KEEPALIVE=2

# ============================================
# File Paths Configuration
# ============================================
DATA_DIR=/app/data
MODEL_DIR=/app/models
OUTPUT_DIR=/app/output
LOG_DIR=/app/logs
CACHE_DIR=/app/cache
CONFIG_DIR=/app/configs
TEMP_DIR=/tmp

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/visionai.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# ============================================
# Security Configuration
# ============================================
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api/v1
API_TITLE=VisionAI-ClipsMaster API
API_DESCRIPTION=AI-powered video clip generation and processing API
API_VERSION=1.0.1
DOCS_URL=/docs
REDOC_URL=/redoc

# ============================================
# Video Processing Configuration
# ============================================
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MAX_VIDEO_SIZE=1GB
MAX_VIDEO_DURATION=3600
SUPPORTED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm
SUPPORTED_AUDIO_FORMATS=mp3,wav,aac,flac

# ============================================
# Model Training Configuration
# ============================================
TRAINING_BATCH_SIZE=8
TRAINING_EPOCHS=10
TRAINING_LEARNING_RATE=0.001
TRAINING_DEVICE=cpu
TRAINING_MIXED_PRECISION=false
TRAINING_GRADIENT_ACCUMULATION_STEPS=1

# ============================================
# Performance Configuration
# ============================================
MAX_WORKERS=4
MEMORY_LIMIT=4GB
CPU_LIMIT=2
PROCESSING_TIMEOUT=1800
CACHE_TTL=3600
MAX_CONCURRENT_TASKS=10

# ============================================
# Monitoring Configuration
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ============================================
# Development Configuration
# ============================================
# Uncomment for development environment
# APP_ENV=development
# DEBUG=true
# DEVELOPMENT=true
# LOG_LEVEL=DEBUG
# RELOAD=true

# ============================================
# External Services Configuration
# ============================================
# Add your external service configurations here
# OPENAI_API_KEY=your-openai-api-key
# HUGGINGFACE_TOKEN=your-huggingface-token
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
